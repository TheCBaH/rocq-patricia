; --- Shell-script structural/assumption audits ----------------------------
; These are lint/invariant checks over generated or hand-written sources,
; not part of the OCaml build graph; left as plain scripts (per the Makefile)
; and just wired into `dune build @runtest` for parity with `make all`
; and `make hashtable`.

(rule
 (alias runtest)
 (deps
  check-assumptions.sh (glob_files *.v) (glob_files *.vo))
 (action (run sh check-assumptions.sh %{bin:rocq} -q -Q . "")))

(rule
 (alias runtest)
 (deps
  check-hashtable-assumptions.sh
  HashTableSpec.v HashTableBits.v HashTableNativeBits.v HashTableBucket.v
  HashTable.v HashTableProof.v HashTableNative.v HashTableNativeProof.v
  HashTableArrayRefinement.v HashTableSkeleton.v
  HashTableSpec.vo HashTableBits.vo HashTableNativeBits.vo HashTableBucket.vo
  HashTable.vo HashTableProof.vo HashTableNative.vo HashTableNativeProof.vo
  HashTableArrayRefinement.vo HashTableSkeleton.vo)
 (action (run sh check-hashtable-assumptions.sh %{bin:rocq} -q -Q . "")))

(rule
 (alias runtest)
 (deps check-extraction-boundary.sh PatriciaExtract.v)
 (action (run sh check-extraction-boundary.sh PatriciaExtract.v)))

(rule
 (alias runtest)
 (deps check-native-string-workers.sh PatriciaExtract.v
  extracted/NativeStringWorker.ml)
 (action
  (run sh check-native-string-workers.sh PatriciaExtract.v
   extracted/NativeStringWorker.ml)))

(rule
 (alias runtest)
 (deps check-native-union-realizers.sh extracted/PatriciaUnion.ml
  extracted/StringPatriciaUnion.ml)
 (action
  (run sh check-native-union-realizers.sh extracted/PatriciaUnion.ml
   extracted/StringPatriciaUnion.ml)))

(rule
 (alias runtest)
 (deps check-cached-representative-consumers.sh
  extracted/StringPatriciaInternal.ml extracted/StringPatriciaUnion.ml
  PatriciaExtract.v)
 (action
  (run sh check-cached-representative-consumers.sh
   extracted/StringPatriciaInternal.ml extracted/StringPatriciaUnion.ml
   PatriciaExtract.v)))

(rule
 (alias runtest)
 (deps check-hashtable-generated-interface.sh
  hashtable_reference_extracted/HashTable.mli)
 (action
  (run sh check-hashtable-generated-interface.sh
   hashtable_reference_extracted/HashTable.mli)))

(rule
 (alias runtest)
 (deps check-hashtable-extraction-boundary.sh HashMap.mli HashMap.ml)
 (action (run sh check-hashtable-extraction-boundary.sh HashMap.mli HashMap.ml)))

(rule
 (alias runtest)
