; Same source as HashTableNativeModelTest.ml, linked against the "native
; array" extraction instead of the plain "native model" one; copied under a
; different module name since a module may only belong to one stanza per
; directory.
(rule
 (target HashTableNativeArrayExtractedTest.ml)
 (action (copy HashTableNativeModelTest.ml HashTableNativeArrayExtractedTest.ml)))

