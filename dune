(rule (alias runtest) (action (run ./hashTableNativeArrayExtractedTest.bc)))

; The Makefile builds these two by sed-substituting HashMap.Make ->
; HashMapNativeExtract.Make over the wrapper/differential sources, to run
; the same test logic against the extracted-wrapper module.
(rule
 (target HashMapNativeExtractTest.ml)
 (deps HashMapTest.ml)
 (action
  (with-stdout-to HashMapNativeExtractTest.ml
   (run sed "s/HashMap\\.Make/HashMapNativeExtract.Make/g" HashMapTest.ml))))

(executable
 (name hashMapNativeExtractTest)
 (modes exe byte)
 (modules HashMapNativeExtractTest)
 (libraries hash_map_native_extract))

(rule (alias runtest) (action (run ./hashMapNativeExtractTest.exe)))
(rule (alias runtest) (action (run ./hashMapNativeExtractTest.bc)))

(rule
 (target HashTableNativeExtractDifferentialTest.ml)
 (deps HashTableDifferentialTest.ml)
 (action
  (with-stdout-to HashTableNativeExtractDifferentialTest.ml
   (run sed "s/HashMap\\.Make/HashMapNativeExtract.Make/g" HashTableDifferentialTest.ml))))

