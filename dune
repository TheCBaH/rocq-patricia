; The Makefile compiled everything with plain ocamlc/ocamlopt and no -w
; flags, so only default-on warnings were ever non-fatal notices, never
; build failures. Match that: dune's own default profile promotes many
; warnings to errors, which neither the hand-written nor the Rocq-extracted
; sources here were written against.
(env
 (_
  (flags (:standard -w -a))))

; Root build: Rocq proofs use a flat (unqualified) logical root, matching
; the original Makefile's `rocq compile -q -Q . ''`. Dune's built-in coq
; stanza always assigns a theory a real logical name, which would force
; every `.v` file's bare `Require Import Foo` to become `From Name Require
; Foo`; these rules invoke `rocq` directly instead so the `.v` sources stay
; untouched.

(rule
 (targets PatriciaBits.vo PatriciaBits.glob)
 (deps PatriciaBits.v)
 (action (run %{bin:rocq} compile -q -Q . "" PatriciaBits.v)))

(rule
 (targets Patricia.vo Patricia.glob)
 (deps Patricia.v PatriciaBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" Patricia.v)))

(rule
 (targets PatriciaProof.vo PatriciaProof.glob)
 (deps PatriciaProof.v PatriciaBits.vo Patricia.vo)
 (action (run %{bin:rocq} compile -q -Q . "" PatriciaProof.v)))

(rule
 (targets StringBits.vo StringBits.glob)
 (deps StringBits.v)
 (action (run %{bin:rocq} compile -q -Q . "" StringBits.v)))

(rule
 (targets StringPatricia.vo StringPatricia.glob)
 (deps StringPatricia.v StringBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" StringPatricia.v)))

(rule
 (targets NativeRefinement.vo NativeRefinement.glob)
 (deps NativeRefinement.v PatriciaBits.vo StringBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" NativeRefinement.v)))

(rule
 (targets NativeStringWorker.vo NativeStringWorker.glob)
 (deps NativeStringWorker.v NativeRefinement.vo StringBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" NativeStringWorker.v)))

(rule
 (targets StringPatriciaProof.vo StringPatriciaProof.glob)
 (deps StringPatriciaProof.v StringBits.vo StringPatricia.vo)
 (action (run %{bin:rocq} compile -q -Q . "" StringPatriciaProof.v)))

(rule
 (targets PatriciaUnion.vo PatriciaUnion.glob)
 (deps PatriciaUnion.v PatriciaBits.vo Patricia.vo)
 (action (run %{bin:rocq} compile -q -Q . "" PatriciaUnion.v)))

(rule
 (targets PatriciaUnionProof.vo PatriciaUnionProof.glob)
 (deps PatriciaUnionProof.v PatriciaProof.vo PatriciaUnion.vo)
 (action (run %{bin:rocq} compile -q -Q . "" PatriciaUnionProof.v)))

(rule
 (targets StringPatriciaUnion.vo StringPatriciaUnion.glob)
 (deps StringPatriciaUnion.v StringBits.vo StringPatricia.vo)
 (action (run %{bin:rocq} compile -q -Q . "" StringPatriciaUnion.v)))

(rule
 (targets StringPatriciaUnionProof.vo StringPatriciaUnionProof.glob)
 (deps StringPatriciaUnionProof.v StringPatriciaProof.vo StringPatriciaUnion.vo)
 (action (run %{bin:rocq} compile -q -Q . "" StringPatriciaUnionProof.v)))

(rule
 (targets NativeHeapRefinement.vo NativeHeapRefinement.glob)
 (deps NativeHeapRefinement.v PatriciaUnionProof.vo StringPatriciaUnionProof.vo)
 (action (run %{bin:rocq} compile -q -Q . "" NativeHeapRefinement.v)))

(rule
 (targets HashTableSpec.vo HashTableSpec.glob)
 (deps HashTableSpec.v)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableSpec.v)))

(rule
 (targets HashTableBits.vo HashTableBits.glob)
 (deps HashTableBits.v HashTableSpec.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableBits.v)))

(rule
 (targets HashTableNativeBits.vo HashTableNativeBits.glob)
 (deps HashTableNativeBits.v HashTableBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableNativeBits.v)))

(rule
 (targets HashTableBucket.vo HashTableBucket.glob)
 (deps HashTableBucket.v HashTableSpec.vo HashTableBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableBucket.v)))

(rule
 (targets HashTable.vo HashTable.glob)
 (deps HashTable.v HashTableSpec.vo HashTableBits.vo HashTableBucket.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTable.v)))

(rule
 (targets HashTableProof.vo HashTableProof.glob)
 (deps HashTableProof.v HashTable.vo HashTableBucket.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableProof.v)))

(rule
 (targets HashTableNative.vo HashTableNative.glob)
 (deps HashTableNative.v HashTable.vo HashTableBits.vo HashTableNativeBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableNative.v)))

(rule
 (targets HashTableNativeProof.vo HashTableNativeProof.glob)
 (deps HashTableNativeProof.v HashTableNative.vo HashTableProof.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableNativeProof.v)))

(rule
 (targets HashTableArrayRefinement.vo HashTableArrayRefinement.glob)
 (deps HashTableArrayRefinement.v HashTableNative.vo HashTableBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableArrayRefinement.v)))

(rule
 (targets HashTableSkeleton.vo HashTableSkeleton.glob)
 (deps HashTableSkeleton.v HashTableSpec.vo HashTableBits.vo)
 (action (run %{bin:rocq} compile -q -Q . "" HashTableSkeleton.v)))

(alias
 (name proof)
 (deps
  PatriciaBits.vo Patricia.vo PatriciaProof.vo StringBits.vo NativeRefinement.vo
  NativeStringWorker.vo StringPatricia.vo StringPatriciaProof.vo PatriciaUnion.vo
  PatriciaUnionProof.vo StringPatriciaUnion.vo StringPatriciaUnionProof.vo
  NativeHeapRefinement.vo))

(alias
 (name hashtable-proof)
 (deps
  HashTableSpec.vo HashTableBits.vo HashTableNativeBits.vo HashTableBucket.vo
  HashTable.vo HashTableProof.vo HashTableNative.vo HashTableNativeProof.vo
  HashTableArrayRefinement.vo HashTableSkeleton.vo))

; Extraction rules live in each output subdirectory's own `dune` file (dune
; rejects targets like "extracted/Foo.ml" from a parent directory's rule);
; see extracted/dune and reference_extracted/dune.

; --- Root OCaml modules --------------------------------------------------
; All `(wrapped false)`: hand-written and extracted sources reference each
; other by bare module name throughout (the Makefile compiled everything
; with plain `-I <dir>`, never OCaml's module-alias wrapping), so keeping
; libraries unwrapped avoids touching any of that source.

(library
 (name patricia)
 (wrapped false)
 (modules PatriciaMap StringPatriciaMap)
 (libraries patricia_extracted))

(library
 (name hashtable_primitives)
 (wrapped false)
 (modules HashTablePrimitives))

(library
 (name hashtable_scalar_primitives)
 (wrapped false)
 (modules HashTableScalarPrimitives))

(library
 (name hash_map)
 (wrapped false)
 (modules HashMap)
 (libraries hashtable_native_array_extracted))

(library
 (name hash_map_native)
 (wrapped false)
 (modules HashMapNative)
 (libraries hashtable_primitives))

(library
 (name hash_map_native_extract)
 (wrapped false)
 (modules HashMapNativeExtract)
 (libraries hashtable_native_array_extracted))

(library
 (name hashtable_reference)
 (wrapped false)
 (modules HashTableReference)
 (libraries hashtable_reference_extracted))

(library
 (name hashtable_test_hash)
 (wrapped false)
 (modules HashTableTestHash))

(library
 (name hashtable_benchmark_support)
 (wrapped false)
 (libraries unix)
 (modules HashTableBenchmarkSupport))

